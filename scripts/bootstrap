#!/bin/sh
set -eu

usage() {
  echo "usage: $0 DESTINATION [--profiles NAME]..." >&2
  exit 2
}

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target=${1-}
[ -n "$target" ] || usage
shift

selected=''
while [ "$#" -gt 0 ]; do
  [ "$1" = --profiles ] || usage
  [ "$#" -ge 2 ] || usage
  name=$2
  shift 2
  case "$name" in *[!a-z0-9-]*|''|-*) echo "invalid profile name: $name" >&2; exit 1;; esac
  case " $selected " in *" $name "*) echo "profile selected more than once: $name" >&2; exit 1;; esac
  selected="$selected $name"
done

workspace_valid() {
  for path in AGENTS.md MOCCA.md docs/constitution.md docs/discovery.md docs/technology.md docs/integrations.md docs/architecture/README.md docs/architecture/adr/README.md docs/autonomy.md docs/workflow.md specs/README.md scripts/verify scripts/apply-profile profiles/catalog; do
    test -e "$1/$path" || return 1
  done
}

if [ -e "$target" ] && [ "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
  if [ -n "$selected" ] && workspace_valid "$target"; then
    set -- "$target/scripts/apply-profile"
    for name in $selected; do set -- "$@" --profiles "$name"; done
    exec "$@"
  fi
  echo "destination must be empty or a valid Mocca workspace with --profiles: $target" >&2
  exit 1
fi

parent=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)
stage=$(mktemp -d "$parent/.mocca-bootstrap.XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
cp -R "$root/templates/core/." "$stage/"
chmod +x "$stage/scripts/verify" "$stage/scripts/apply-profile"
printf '%s\n' 'Mocca bootstrap staging' >"$stage/.mocca-bootstrap-staging"

if [ -n "$selected" ]; then
  set -- "$stage/scripts/apply-profile" --bootstrap-initialization
  for name in $selected; do set -- "$@" --profiles "$name"; done
  "$@"
fi
rm -f "$stage/.mocca-bootstrap-staging"

if [ -e "$target" ]; then
  rmdir "$target" 2>/dev/null || { echo "destination changed during bootstrap: $target" >&2; exit 1; }
fi
mv "$stage" "$target"
trap - EXIT HUP INT TERM
echo "Created Mocca workspace in $target"
